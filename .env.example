# MongoDB Atlas connection string (required for live data)
MONGODB_URI=

# Long random string (32+ chars) used to sign admin + customer sessions
ADMIN_SESSION_SECRET=

# Public base URL, e.g. https://dpmgoods.com (used for SEO, sitemap, payment redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# First admin account created by `npm run seed`
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional payment provider (server-only keys must never use NEXT_PUBLIC_)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
